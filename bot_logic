import random

def gen_pass(pass_length):
    elements = "+-/*!&$#?=@<>0123456789"
    password = ""
    for i in range(pass_length):
        password += random.choice(elements)
    return password

def cara_ou_coroa():
    return random.choice(["Cara", "Coroa"])

